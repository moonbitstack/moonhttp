// The two encodings an HTML form submits, picked by Content-Type:
// https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#form-submission-algorithm
//
// Each decoder lives with its format: multipart/form-data in moonmime,
// application/x-www-form-urlencoded in moonurl. Choosing between them is a
// question about an HTTP request, so it is here.
import {
  "moonbitstack/moonmime",
  "moonbitstack/moonurl",
}

import {
  "moonbitlang/core/encoding/utf8",
} for "test"
