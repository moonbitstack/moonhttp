// Conditional requests, RFC 9110 §8.8 and §13:
// https://www.rfc-editor.org/rfc/rfc9110#section-13
//
// The entity-tag a server puts on a representation, the five fields a client
// sends it back in, and the order §13.2.2 weighs them in. This turns a repeat
// request into a 304, and tells a resumed download it is still the same file.
//
// Generating and comparing live together: a client echoes a tag it was given,
// and a server that compares wrote one first.
//
// The digest is a parameter, so this depends on the contract and not on any
// algorithm.
import {
  "moonbitstack/moondate",
  "moonbitstack/mooncrypt/spec",
  "moonbitstack/moonbase",
  "moonbitstack/moonbase/base16",
}

import {
  "moonbitstack/moonhttp/conditional",
  "moonbitstack/moondate",
  "moonbitstack/mooncrypt/hash/sha2",
} for "test"
