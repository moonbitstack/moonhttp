name = "moonbitstack/moonhttp"

version = "0.15.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonhttp"

license = "Apache-2.0"

keywords = [
  "http",
  "http2",
  "etag",
  "http3",
  "websocket",
  "hpack",
  "qpack",
  "protocol",
  "moonbit",
]

description = "HTTP formats for MoonBit with no I/O: HTTP/1 to HTTP/3, WebSocket, SSE and multipart."

import {
  "moonbitstack/moonvar@0.2.0",
  "moonbitstack/moondate@0.1.0",
  "moonbitstack/mooncrypt@0.3.1",
  "moonbitstack/moonbase@0.4.0",
  "moonbitstack/moonmime@0.2.0",
  "moonbitstack/moonurl@0.2.0",
  "moonbitstack/moonzip@0.3.0",
  "moonbitlang/async@0.22.5",
}

source = "src"
