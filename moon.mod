name = "moonbitstack/moonhttp"

version = "0.15.10"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonhttp"

license = "Apache-2.0"

keywords = [
  "http",
  "http1",
  "http2",
  "http3",
  "hpack",
  "qpack",
  "huffman",
  "websocket",
  "ws",
  "permessage-deflate",
  "sse",
  "server-sent-events",
  "eventsource",
  "multipart",
  "form",
  "urlencoded",
  "cookie",
  "cookies",
  "etag",
  "conditional-requests",
  "range-requests",
  "cache-control",
  "caching",
  "headers",
  "h2c",
  "upgrade",
  "protocol",
  "sans-io",
  "rfc9110",
  "rfc9111",
  "rfc9112",
  "rfc9113",
  "rfc9114",
  "rfc7541",
  "rfc9204",
  "rfc6455",
  "rfc7692",
  "rfc9220",
  "rfc8441",
  "rfc6265",
  "moonbit",
]

description = "HTTP formats for MoonBit with no I/O: HTTP/1 to HTTP/3, WebSocket, SSE and multipart."

import {
  "moonbitstack/moonvar@0.2.2",
  "moonbitstack/moondate@0.1.6",
  "moonbitstack/mooncrypt@0.4.13",
  "moonbitstack/moonbase@0.4.4",
  "moonbitstack/moonmime@0.2.5",
  "moonbitstack/moonurl@0.2.6",
  "moonbitstack/moonzip@0.3.8",
  "moonbitlang/async@0.22.5",
}

source = "src"
